<Application x:Class="ToolKitV.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ToolKitV">
    <Application.Resources>

        <!-- ══════════════════════════════════════════════════════════
             FONT FAMILIES
        ══════════════════════════════════════════════════════════ -->
        <FontFamily x:Key="TT Norms Regular">Assets/Fonts/#TT Norms Regular</FontFamily>
        <FontFamily x:Key="TT Norms Medium">Assets/Fonts/#TT Norms Medium</FontFamily>
        <FontFamily x:Key="TT Norms Bold">Assets/Fonts/#TT Norms Bold</FontFamily>

        <!-- ══════════════════════════════════════════════════════════
             COLOR TOKENS — Red / Black Design System
        ══════════════════════════════════════════════════════════ -->
        <Color x:Key="AccentRed">#C0132A</Color>
        <Color x:Key="AccentRedBright">#FF3A3A</Color>
        <Color x:Key="AccentRedDim">#801020</Color>
        <Color x:Key="SurfaceDark">#0D0D10</Color>
        <Color x:Key="SurfaceMid">#14141A</Color>
        <Color x:Key="SurfaceCard">#0CFFFFFF</Color>
        <Color x:Key="BorderSubtle">#18FFFFFF</Color>
        <Color x:Key="TextPrimary">#F0FFFFFF</Color>
        <Color x:Key="TextMuted">#60FFFFFF</Color>
        <Color x:Key="TextDim">#30FFFFFF</Color>

        <SolidColorBrush x:Key="AccentRedBrush" Color="#C0132A"/>
        <SolidColorBrush x:Key="AccentRedBrightBrush" Color="#FF3A3A"/>
        <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#0D0D10"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#60FFFFFF"/>

        <!-- ══════════════════════════════════════════════════════════
             GLOBAL SCROLLBAR — Thin dark-red theme
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                CornerRadius="3"
                                Background="#35C0132A"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#65C0132A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#90C0132A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Width="7">
                            <!-- Track background -->
                            <Border CornerRadius="3" Background="#08FFFFFF" Margin="1"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Horizontal scrollbar -->
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Height="7">
                                    <Border CornerRadius="3" Background="#08FFFFFF" Margin="1"/>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                          Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                          Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             GLOBAL RADIOBUTTON STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D0FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource TT Norms Regular}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Custom radio dot -->
                            <Border x:Name="RadioOuter"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    BorderThickness="1.5"
                                    BorderBrush="#30FFFFFF"
                                    Background="#08FFFFFF"
                                    Margin="0 0 8 0">
                                <Ellipse x:Name="RadioDot"
                                         Width="7" Height="7"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="#C0132A"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioDot"    Property="Visibility"    Value="Visible"/>
                                <Setter TargetName="RadioOuter"  Property="BorderBrush"   Value="#C0132A"/>
                                <Setter TargetName="RadioOuter"  Property="Background"    Value="#15C0132A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioOuter" Property="BorderBrush" Value="#60C0132A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             GLOBAL COMBOBOX STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#D0FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource TT Norms Regular}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10 0 28 0"
                                                      VerticalAlignment="Center"/>
                                    <!-- Arrow -->
                                    <TextBlock Text="▾"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="#50FFFFFF"
                                               FontSize="10"
                                               Margin="0 0 10 0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="#25FFFFFF"
                                        Background="#1A1A22">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#40C0132A"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#60C0132A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#D0FFFFFF"/>
                        <Setter Property="FontFamily" Value="{StaticResource TT Norms Regular}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10 6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#20C0132A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#30C0132A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             GLOBAL TOOLTIP STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="Foreground" Value="#D0FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource TT Norms Regular}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 5"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             LEGACY — kept for any view that explicitly references it,
             now themed to match the red/black system
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C0132A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12 6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource TT Norms Bold}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0132A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
