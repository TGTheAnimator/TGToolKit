<UserControl x:Class="ToolKitV.Views.ViewportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             ClipToBounds="True"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             SizeChanged="UserControl_SizeChanged"
             Focusable="True">
    <Grid Background="#0A0A0C" ClipToBounds="True">
        <Grid>
            <Image x:Name="ViewportImage" Stretch="Fill" />

            <!-- FPS Counter overlay (moved to bottom-left to avoid overlaps) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="5,2" Background="#80000000" CornerRadius="4">
                <TextBlock x:Name="FpsText" Text="60 FPS" Foreground="White" FontSize="10" FontFamily="{StaticResource TT Norms Regular}"/>
            </Border>

            <!-- 🎯 Zone Builder Overlay Panel -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="320" Margin="20" 
                    Background="#D8111111" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                <StackPanel Margin="15">
                    <TextBlock Text="🎯 Zone Builder" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Shift+Left Click to place point(s). Shift+Right Click to clear. Alt+Shift+Left Click snaps to 3D vertices! Press Ctrl+Z to undo." 
                               Foreground="#AAA" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton x:Name="rbPolyZone" Content="PolyZone" Foreground="White" IsChecked="True" Checked="ZoneMode_Changed" Margin="0,0,15,0"/>
                        <RadioButton x:Name="rbBoxZone" Content="BoxZone" Foreground="White" Checked="ZoneMode_Changed"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Height (Z) slider -->
                        <TextBlock Text="Height (Z):" Foreground="#AAA" VerticalAlignment="Center" Grid.Row="0"/>
                        <Slider x:Name="sldHeight" Minimum="0.5" Maximum="10.0" Value="2.0" Grid.Column="1" Grid.Row="0" Margin="10,0" ValueChanged="UI_ZoneParamChanged"/>
                        <TextBlock Text="{Binding Value, ElementName=sldHeight, StringFormat=N1}" Foreground="White" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center"/>

                        <!-- Width (X) slider - BoxZone only -->
                        <TextBlock x:Name="lblWidth" Text="Width (X):" Foreground="#AAA" VerticalAlignment="Center" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Slider x:Name="sldWidth" Minimum="0.5" Maximum="20.0" Value="1.0" Grid.Column="1" Grid.Row="1" Margin="10,10,10,0" ValueChanged="UI_ZoneParamChanged" Visibility="Collapsed"/>
                        <TextBlock x:Name="valWidth" Text="{Binding Value, ElementName=sldWidth, StringFormat=N1}" Foreground="White" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

                        <!-- Length (Y) slider - BoxZone only -->
                        <TextBlock x:Name="lblLength" Text="Length (Y):" Foreground="#AAA" VerticalAlignment="Center" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Slider x:Name="sldLength" Minimum="0.5" Maximum="20.0" Value="1.0" Grid.Column="1" Grid.Row="2" Margin="10,10,10,0" ValueChanged="UI_ZoneParamChanged" Visibility="Collapsed"/>
                        <TextBlock x:Name="valLength" Text="{Binding Value, ElementName=sldLength, StringFormat=N1}" Foreground="White" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

                        <!-- Heading slider - BoxZone only -->
                        <TextBlock x:Name="lblHeading" Text="Heading:" Foreground="#AAA" VerticalAlignment="Center" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Slider x:Name="sldHeading" Minimum="0" Maximum="360" Value="0" Grid.Column="1" Grid.Row="3" Margin="10,10,10,0" ValueChanged="UI_ZoneParamChanged" Visibility="Collapsed"/>
                        <TextBlock x:Name="valHeading" Text="{Binding Value, ElementName=sldHeading, StringFormat=N0}" Foreground="White" Grid.Column="2" Grid.Row="3" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </Grid>

                    <TextBlock Text="Generated Lua:" Foreground="White" Margin="0,10,0,5"/>
                    <TextBox x:Name="txtLuaOutput" Height="180" Background="#0A0A0A" Foreground="#00FF00" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                    
                    <Button Content="Copy Code" Height="30" Margin="0,10,0,0" Background="#C0132A" Foreground="White" FontWeight="Bold" Click="btnCopyCode_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Placeholder overlay when inactive or loading -->
            <Border x:Name="OverlayBorder" Background="#B0000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="3D VIEWPORT" Foreground="#80FFFFFF" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Idling to save resources..." Foreground="#50FFFFFF" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
