                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EconomyLabel" Text="Economy Balancer"
                                       Foreground="#A0FFFFFF" FontFamily="Fonts/#TT Norms"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
