<UserControl x:Class="ToolKitV.Views.Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Hover glow style applied to every nav Border -->
        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0 2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0DC0132A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section label style -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#35FFFFFF"/>
            <Setter Property="FontFamily" Value="Fonts/#TT Norms"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="14 14 0 6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─── Nav items ─── -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10 8 10 0">
            <StackPanel>

                <!-- ══ SECTION: CORE TOOLS ══ -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="CORE TOOLS"/>

                <!-- Texture Optimizer -->
                <Border x:Name="TextureOptimizerItem" Style="{StaticResource NavItem}"
                        MouseLeftButtonDown="TextureOptimizer_Click">
                    <Grid>
                        <Border x:Name="TextureOptimizerBg" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#32C0132A" Offset="0"/>
                                    <GradientStop Color="#18C0132A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="TextureOptimizerInactiveBg" CornerRadius="8"
                                Background="Transparent" Visibility="Collapsed"/>
                        <Rectangle x:Name="TextureOptimizerStripe"
                                   Width="3" HorizontalAlignment="Left" RadiusX="2" RadiusY="2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF4040" Offset="0"/>
                                    <GradientStop Color="#C0132A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                  Color="#C0132A" Opacity="0.8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14 0 0 0">
                            <Border Width="22" Height="22" CornerRadius="5" Background="#25C0132A"
                                    VerticalAlignment="Center" Margin="0 0 10 0">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Foreground="#FF6060" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TextureOptimizerLabel"
                                       Text="Texture Optimizer"
                                       Foreground="#FFFFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Vehicle Tools -->
                <Border x:Name="VehiclesItem" Style="{StaticResource NavItem}"
                        MouseLeftButtonDown="Vehicles_Click">
                    <Grid>
                        <Border x:Name="VehiclesBg" CornerRadius="8" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#32C0132A" Offset="0"/>
                                    <GradientStop Color="#18C0132A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="VehiclesInactiveBg" CornerRadius="8" Background="Transparent"/>
                        <Rectangle x:Name="VehiclesStripe" Width="3" HorizontalAlignment="Left"
                                   RadiusX="2" RadiusY="2" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF4040" Offset="0"/>
                                    <GradientStop Color="#C0132A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#C0132A" Opacity="0.8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14 0 0 0">
                            <Border Width="22" Height="22" CornerRadius="5" Background="#18FFFFFF"
                                    VerticalAlignment="Center" Margin="0 0 10 0">
                                <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" Foreground="#FFA0A0" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="VehiclesLabel" Text="Vehicle Tools"
                                       Foreground="#A0FFFFFF" FontFamily="Fonts/#TT Norms"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

