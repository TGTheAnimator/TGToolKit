        <!-- ─── Footer ─── -->
        <Border Grid.Row="1" BorderThickness="0 1 0 0" BorderBrush="#10FFFFFF" Padding="14 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Author name with red accent dot -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 2">
                    <Ellipse Width="6" Height="6" Fill="#C0132A"
                             VerticalAlignment="Center" Margin="0 0 6 0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="0"
                                              Color="#C0132A" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="TGTheAnimator"
                               Foreground="#50FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Version badge -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 2 0 0">
                    <Border CornerRadius="3" Background="#18C0132A"
                            BorderBrush="#25C0132A" BorderThickness="1"
                            Padding="5 2">
                        <TextBlock x:Name="VersionText"
                                   Text="v3.4.1"
                                   Foreground="#60C0132A"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Update banner -->
                <TextBlock x:Name="UpdateBanner"
                           Grid.Row="2"
                           Text="⬆  UPDATE AVAILABLE"
                           Foreground="#4CFF70"
                           FontFamily="Fonts/#TT Norms"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0 5 0 0"
                           Cursor="Hand"
                           Visibility="Collapsed"
                           MouseLeftButtonDown="UpdateBanner_Click">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                          Color="#4CFF70" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
