<UserControl x:Class="ToolKitV.Views.InputText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d"
             d:DataContext="{Binding Mode=Default, RelativeSource={RelativeSource Self}}">
    <StackPanel>
        <!-- Label -->
        <TextBlock Text="{Binding Title}"
                   Foreground="#C0FFFFFF"
                   FontFamily="Fonts/#TT Norms"
                   FontSize="11"
                   FontWeight="Bold"
                   Margin="0 0 0 5"/>

        <!-- Input with focus ring border -->
        <Border x:Name="InputBorder"
                CornerRadius="7"
                BorderThickness="1"
                BorderBrush="#15FFFFFF"
                Background="#0AFFFFFF">
            <TextBox x:Name="TheTextBox"
                     Padding="10 0"
                     Height="36"
                     Background="Transparent"
                     BorderBrush="Transparent"
                     Foreground="#C0FFFFFF"
                     FontFamily="Fonts/#TT Norms"
                     FontSize="12"
                     Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                     SelectionBrush="#60C0132A"
                     CaretBrush="#C0132A"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsInputEnabled}"
                     FocusVisualStyle="{x:Null}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Focus ring -->
                        <DataTrigger Binding="{Binding ElementName=TheTextBox, Path=IsFocused}" Value="True">
                            <Setter Property="BorderBrush" Value="#55C0132A"/>
                            <Setter Property="Background"  Value="#14C0132A"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                      Color="#C0132A" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- Disabled -->
                        <DataTrigger Binding="{Binding IsInputEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Description hint -->
        <TextBlock Text="{Binding Description}"
                   Foreground="#35FFFFFF"
                   FontFamily="Fonts/#TT Norms"
                   FontSize="10"
                   Margin="2 4 0 0"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
