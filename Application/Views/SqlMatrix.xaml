<UserControl x:Class="ToolKitV.Views.SqlMatrix"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="28 20 28 20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ COLUMN 0: DATABASE & CONNECTION CONTROLS ══ -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <!-- Primary Scan & Fix actions docked to the bottom -->
            <Grid DockPanel.Dock="Bottom" Margin="0 16 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:Button x:Name="TestConnectionBtn"
                               Grid.Row="0"
                               Title="⚡ Test Database Connection"
                               IsButtonEnabledValue="True"
                               Click="TestConnectionBtn_Click"/>

                <local:Button x:Name="ScanBtn"
                               Grid.Row="2"
                               Title="🪄 Scan Resources &amp; Compare"
                               IsButtonEnabledValue="True"
                               Click="ScanBtn_Click"/>
            </Grid>

            <!-- Scrollable configurations area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0 0 10 0">
                <StackPanel>
                    
                    <!-- Section Header -->
                    <TextBlock Text="SQL MIGRATION MATRIX"
                               Foreground="#FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0 0 0 4"/>

                    <TextBlock Text="Inspects FiveM scripts for .sql schemas and validates your live database alignment automatically."
                               Foreground="#70FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0 0 0 20"/>

                    <!-- Database connection group -->
                    <TextBlock Text="LIVE DATABASE CREDENTIALS"
                               Foreground="#80FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 14"
                            Margin="0 0 0 20">
                        <StackPanel>
                            <local:InputText x:Name="DbHost" Title="MySQL Host" Margin="0 0 0 8"/>
                            <local:InputText x:Name="DbPort" Title="Port" Margin="0 0 0 8"/>
                            <local:InputText x:Name="DbUser" Title="Username" Margin="0 0 0 8"/>

                            <!-- Password Input -->
                            <TextBlock Text="Password"
                                       Foreground="#C0FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0 0 0 5"/>
                            <Border CornerRadius="7"
                                    BorderThickness="1"
                                    BorderBrush="#15FFFFFF"
                                    Background="#0AFFFFFF"
                                    Padding="10 8"
                                    Margin="0 0 0 8">
                                <PasswordBox x:Name="DbPassword"
                                             Background="Transparent"
                                             Foreground="White"
                                             BorderThickness="0"
                                             FontFamily="Fonts/#TT Norms"
                                             FontSize="12"
                                             FocusVisualStyle="{x:Null}"/>
                            </Border>

                            <local:InputText x:Name="DbName" Title="Database Name" Margin="0 0 0 4"/>
                        </StackPanel>
                    </Border>

                    <!-- Scanning folder source mode group -->
                    <TextBlock Text="RESOURCE SCAN MODE"
                               Foreground="#80FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 14"
                            Margin="0 0 0 20">
                        <StackPanel>
                            
                            <!-- Toggle mode selector -->
                            <Grid Margin="0 0 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <RadioButton x:Name="ModeLocalBtn"
                                             Grid.Column="0"
                                             Content="Local Folder"
                                             IsChecked="True"
                                             Checked="Mode_Changed"
                                             Foreground="White"
                                             FontFamily="Fonts/#TT Norms"
                                             FontSize="12"
                                             Cursor="Hand"/>

                                <RadioButton x:Name="ModeSftpBtn"
                                             Grid.Column="1"
                                             Content="Remote SFTP"
                                             Checked="Mode_Changed"
                                             Foreground="White"
                                             FontFamily="Fonts/#TT Norms"
                                             FontSize="12"
                                             Cursor="Hand"/>
                            </Grid>

                            <!-- Folder Picker for Local mode -->
                            <StackPanel x:Name="LocalFolderPanel" Margin="0 6 0 0">
                                <local:SelectFolder x:Name="LocalFolder"
                                                     Title="Local Resources Folder"/>
                            </StackPanel>

                            <!-- Dynamic Info Label for SFTP mode -->
                            <StackPanel x:Name="SftpInfoPanel" Visibility="Collapsed" Margin="0 6 0 0">
                                <Border CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="#30FFB347"
                                        Background="#0DFFB347"
                                        Padding="10 8">
                                    <TextBlock x:Name="SftpInfoText"
                                               Text="Using active SFTP credentials set in Server Linter. Connection targets:"
                                               Foreground="#FFB347"
                                               FontFamily="Fonts/#TT Norms"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ══ COLUMN 2: SCHEMA MATRIX & REAL-TIME GRID ══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Progress & console reporting block -->
            <Border x:Name="ProgressCard"
                    Grid.Row="0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#30FFB347"
                    Background="#0DFFB347"
                    Padding="18 14"
                    Margin="0 0 0 16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StatusLabel"
                               Text="Analysing schema matrices..."
                               Foreground="#E0FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 BorderThickness="0"
                                 Background="#20FFFFFF">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFB347" Offset="0"/>
                                <GradientStop Color="#FF5555" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- Sleek Dark Matrix Grid -->
            <Border Grid.Row="1"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#15FFFFFF"
                    Background="#0CFFFFFF"
                    Padding="18 16"
                    Margin="0 0 0 16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 14">
                        <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF5555" Offset="0"/>
                                    <GradientStop Color="#C0132A" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="REQUIRED DATABASE SCHEMA MAP"
                                   Foreground="#80FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Custom styled DataGrid for premium feel -->
                    <DataGrid x:Name="MatrixGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#05FFFFFF"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              VerticalGridLinesBrush="Transparent"
                              HorizontalGridLinesBrush="Transparent"
                              RowHeaderWidth="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              FontFamily="Fonts/#TT Norms"
                              FontSize="12"
                              Foreground="White">
                        <DataGrid.Resources>
                            <!-- Header Style -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#50FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10 8"/>
                                <Setter Property="BorderThickness" Value="0 0 0 1"/>
                                <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                            </Style>
                            <!-- Cell Style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10 8"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Row Style -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Resource Column -->
                            <DataGridTextColumn Header="RESOURCE"
                                                Binding="{Binding ResourceName}"
                                                Width="2*"/>
                            
                            <!-- SQL Source File -->
                            <DataGridTextColumn Header="SOURCE SQL FILE"
                                                Binding="{Binding SourceFile}"
                                                Width="2*"/>

                            <!-- Table Name -->
                            <DataGridTextColumn Header="TABLE NAME"
                                                Binding="{Binding TableName}"
                                                Width="2.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E0FFFFFF"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status column styled dynamically -->
                            <DataGridTemplateColumn Header="LIVE DB STATUS" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5 0">
                                            <!-- Colored Accent dot -->
                                            <Ellipse Width="6" Height="6" Margin="0 0 8 0" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{Binding StatusColor}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#70FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExistsInLiveDb}" Value="False">
                                                                <Setter Property="Foreground" Value="#FF5555"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExistsInLiveDb}" Value="True">
                                                                <Setter Property="Foreground" Value="#4CFF70"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>

            <!-- Bottom Glowing Execution Bar -->
            <Border Grid.Row="2"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#354CFF70"
                    Background="#0D4CFF70"
                    Padding="18 14"
                    x:Name="RemediationCard"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="RemediationTitleText"
                                   Text="✓ Schema misalignment detected!"
                                   Foreground="#4CFF70"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0 0 0 3"/>
                        <TextBlock x:Name="RemediationDescText"
                                   Text="Click the button on the right to automatically deploy missing tables to the database."
                                   Foreground="#70FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="11"/>
                    </StackPanel>

                    <!-- Deploy remediation execution button -->
                    <Button x:Name="ExecuteBtn"
                            Grid.Column="1"
                            Content="⚡ Deploy Missing Schema"
                            Click="ExecuteBtn_Click"
                            Cursor="Hand"
                            FontFamily="Fonts/#TT Norms"
                            FontSize="12"
                            FontWeight="Bold"
                            Height="38"
                            Padding="20 0"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg"
                                                    CornerRadius="8"
                                                    Background="#254CFF70"
                                                    BorderBrush="#504CFF70"
                                                    BorderThickness="1">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="#4CFF70"
                                                           FontFamily="Fonts/#TT Norms"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="16 0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"  Value="#3C4CFF70"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#804CFF70"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#554CFF70"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
