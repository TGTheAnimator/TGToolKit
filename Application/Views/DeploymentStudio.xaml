<UserControl x:Class="ToolKitV.Views.DeploymentStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28 20 28 20">
        <!-- Main Layout Split: Left for Wizard, Right for Deployment Info/Actions -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL: WIZARD STEPS ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="🚀 ZERO-TO-HERO ORCHESTRATOR" 
                           Foreground="#FF5555" 
                           FontFamily="Fonts/#TT Norms" 
                           FontWeight="Bold" 
                           FontSize="18" 
                           Margin="0 0 0 4"/>
                <TextBlock Text="Compile, standardize, secure, and deploy your entire server ecosystem in one click." 
                           Foreground="#80FFFFFF" 
                           FontFamily="Fonts/#TT Norms" 
                           FontSize="11" 
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Wizard Step Containers -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0 0 8 0">
                <Grid>
                    <!-- STEP 1: Core Ecosystem -->
                    <StackPanel x:Name="Step1Panel" Visibility="Visible">
                        <TextBlock Text="STEP 1: THE CORE ECOSYSTEM" Foreground="#FFD700" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="11" Margin="0 10 0 14"/>

                        <!-- Scan Mode -->
                        <TextBlock Text="DEPLOYMENT TARGET MODE" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="14 10" Margin="0 0 0 16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LocalModeRadio" Content="Local Folder" IsChecked="True" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" Margin="0 0 20 0" Checked="ModeRadio_Changed"/>
                                <RadioButton x:Name="SftpModeRadio" Content="SFTP (Remote)" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" Checked="ModeRadio_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Local Workspace -->
                        <StackPanel x:Name="LocalPanel" Visibility="Visible">
                            <TextBlock Text="SERVER RESOURCES DIRECTORY" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                            <local:SelectFolder x:Name="LocalFolder" Path="" Margin="0 0 0 16"/>
                        </StackPanel>

                        <!-- SFTP Connections -->
                        <StackPanel x:Name="SftpPanel" Visibility="Collapsed">
                            <TextBlock Text="SFTP CONNECTION SETTINGS" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                            <local:InputText x:Name="SftpHost" Title="Host / IP" Margin="0 0 0 8"/>
                            <local:InputNumber x:Name="SftpPort" Title="Port" Value="22" Margin="0 0 0 8"/>
                            <local:InputText x:Name="SftpUsername" Title="Username" Margin="0 0 0 8"/>
                            <TextBlock Text="Password" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="10" Margin="0 0 0 6"/>
                            <Border CornerRadius="6" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#0CFFFFFF" Padding="10 8" Margin="0 0 0 8">
                                <PasswordBox x:Name="SftpPassword" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            </Border>
                            <local:InputText x:Name="SftpRootPath" Title="Remote Resources Path" Margin="0 0 0 16"/>
                        </StackPanel>

                        <!-- Framework & Dependency Selection -->
                        <TextBlock Text="CORE SYSTEM FRAMEWORK" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="6" Margin="0 0 0 16">
                            <ComboBox x:Name="FrameworkCombo" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" Padding="6" SelectedIndex="0">
                                <ComboBoxItem Content="Qbox Framework (Recommended)"/>
                                <ComboBoxItem Content="QBCore Framework"/>
                                <ComboBoxItem Content="ESX Legacy Framework"/>
                                <ComboBoxItem Content="Standalone (No framework)"/>
                            </ComboBox>
                        </Border>

                        <TextBlock Text="TARGET INVENTORY SYSTEM" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="6" Margin="0 0 0 16">
                            <ComboBox x:Name="InventoryCombo" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" Padding="6" SelectedIndex="0">
                                <ComboBoxItem Content="ox_inventory (Overextended)"/>
                                <ComboBoxItem Content="jpr-inventory"/>
                                <ComboBoxItem Content="qs-inventory (Quasar)"/>
                                <ComboBoxItem Content="qb-inventory"/>
                            </ComboBox>
                        </Border>

                        <TextBlock Text="VOICE SYSTEM ROUTING" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="6" Margin="0 0 0 16">
                            <ComboBox x:Name="VoiceCombo" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" Padding="6" SelectedIndex="0">
                                <ComboBoxItem Content="pma-voice (Native Mumble 3D)"/>
                                <ComboBoxItem Content="mumble-voip"/>
                                <ComboBoxItem Content="SaltyChat (Teamspeak 3 Integration)"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- STEP 2: Globals Settings -->
                    <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                        <TextBlock Text="STEP 2: GLOBAL ENVIRONMENT VARIABLES" Foreground="#FFD700" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="11" Margin="0 10 0 14"/>

                        <local:InputText x:Name="MasterWebhookInput" Title="Master Discord Webhook URL" Margin="0 0 0 16"/>

                        <TextBlock Text="MASTER LANGUAGE LOCALE" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="6" Margin="0 0 0 16">
                            <ComboBox x:Name="LocaleCombo" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" Padding="6" SelectedIndex="0">
                                <ComboBoxItem Content="en (English)"/>
                                <ComboBoxItem Content="es (Spanish)"/>
                                <ComboBoxItem Content="fr (French)"/>
                                <ComboBoxItem Content="de (German)"/>
                                <ComboBoxItem Content="it (Italian)"/>
                                <ComboBoxItem Content="pt (Portuguese)"/>
                            </ComboBox>
                        </Border>

                        <local:InputText x:Name="MySqlConnectionStringInput" Title="MySQL Connection String (For SQL Matrix)" Margin="0 0 0 16"/>

                        <TextBlock Text="SNAP-SHOT SAFETY BACKUP" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 6"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#30FF5555" Background="#0DFF5555" Padding="14 12" Margin="0 0 0 16">
                            <StackPanel>
                                <TextBlock Text="🛡️ Temporal Failsafe Active" Foreground="#FF8888" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="12" Margin="0 0 0 4"/>
                                <TextBlock Text="TGToolKit will compress your server's initial state prior to writing any files. Rollbacks are 100% secure." Foreground="#FFCCCC" FontFamily="Fonts/#TT Norms" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Navigation Buttons -->
            <Grid Grid.Row="3" Margin="0 16 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Content="Back" Height="40" Background="#222" Foreground="White" BorderThickness="0" Margin="0 0 6 0" Visibility="Collapsed" Click="BackButton_Click"/>
                <Button x:Name="NextButton" Grid.Column="1" Content="Next Step" Height="40" Background="#C0132A" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="6 0 0 0" Click="NextButton_Click"/>
                <Button x:Name="DeployButton" Grid.Column="1" Content="Deploy Server" Height="40" Background="#30E080" Foreground="Black" FontWeight="Bold" BorderThickness="0" Margin="6 0 0 0" Visibility="Collapsed" Click="DeployButton_Click"/>
            </Grid>
        </Grid>

        <!-- ═══ RIGHT PANEL: MONITOR & LOGS ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Execution Header Status -->
            <Border Grid.Row="0" x:Name="ProgressHeaderCard" CornerRadius="10" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="18 16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgressStateText" Text="Deploying Indestructible Ecosystem..." Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
                    <ProgressBar x:Name="DeploymentProgressBar" IsIndeterminate="True" Height="4" BorderThickness="0" Background="#20FFFFFF">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#30E080" Offset="0"/>
                                <GradientStop Color="#00B0FF" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- Default Info Card (Before Deploy) -->
            <Border Grid.Row="0" x:Name="DefaultHeaderCard" CornerRadius="10" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="18 16" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="ORCHESTRATOR STATUS: IDLE" Foreground="#80FFFFFF" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="12" Margin="0 0 0 4"/>
                    <TextBlock Text="Configure steps 1 &amp; 2, then click Deploy to compile and patch your FiveM workspace." Foreground="#60FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Live Monitoring Dashboard -->
            <Grid Grid.Row="2" Margin="0 12 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- Checkpoints / Milestones -->
                <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#0CFFFFFF" Padding="14 12">
                    <StackPanel>
                        <TextBlock Text="DEPLOYMENT CHECKPOINTS" Foreground="#40FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="9" FontWeight="Bold" Margin="0 0 0 10"/>
                        
                        <!-- Checkpoint Items -->
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon1" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText1" Grid.Column="1" Text="Pre-Deployment Safety Snapshot" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon2" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText2" Grid.Column="1" Text="Static Code Syntax Diagnostics" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon3" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText3" Grid.Column="1" Text="Server Linter &amp; Modern Manifests" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon4" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText4" Grid.Column="1" Text="SQL Matrix Database Verification" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon5" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText5" Grid.Column="1" Text="Smart Asset Harvesting &amp; Injection" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon6" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText6" Grid.Column="1" Text="Qbox &amp; Overextended Transpiler Upgrade" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon7" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText7" Grid.Column="1" Text="Integration Bridge Core Engine Patches" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckIcon8" Grid.Column="0" Text="⚪" Foreground="#555" Margin="0 0 10 0" FontSize="12"/>
                            <TextBlock x:Name="CheckText8" Grid.Column="1" Text="Master Webhook, Locales &amp; Push" Foreground="#70FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live System Log Stream -->
                <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" BorderBrush="#15FFFFFF" Background="#05FFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#111" CornerRadius="8,8,0,0" Padding="10 6">
                            <TextBlock Text="SYSTEM LOG MONITOR" Foreground="#60FFFFFF" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBox Grid.Row="1" x:Name="SystemLogBox" IsReadOnly="True" Background="Black" Foreground="#60F080" BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
