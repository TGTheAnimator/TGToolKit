<UserControl x:Class="ToolKitV.Views.RecipeStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#050505">
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="🛠️ Recipe Studio" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="18" Margin="0,0,0,15"/>
                
                <TextBlock Text="Recipe ID (e.g., qbx_to_jpr):" Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                <TextBox x:Name="txtRecipeId" Background="#111" Foreground="White" BorderBrush="#333" Padding="5" Margin="0,5,0,10"/>

                <TextBlock Text="Required Resource:" Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                <TextBox x:Name="txtRequired" Background="#111" Foreground="White" BorderBrush="#333" Padding="5" Margin="0,5,0,10"/>

                <TextBlock Text="Target Resource (To Patch):" Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                <TextBox x:Name="txtTarget" Background="#111" Foreground="White" BorderBrush="#333" Padding="5" Margin="0,5,0,10"/>

                <TextBlock Text="Description:" Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="11"/>
                <TextBox x:Name="txtDescription" Background="#111" Foreground="White" BorderBrush="#333" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,5,0,10"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Target File Path:" Foreground="#888" FontFamily="Fonts/#TT Norms" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtFilePath" Width="300" Background="#111" Foreground="White" BorderBrush="#333" Padding="5"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Text="Search Snippet (Paste Raw Lua):" Foreground="#FFB347" FontFamily="Fonts/#TT Norms" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSearch" Grid.Row="1" Background="#111" Foreground="#FFB347" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderBrush="#333" Padding="10" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="2" Text="Replace With (Paste Raw Lua):" Foreground="#4CFF70" FontFamily="Fonts/#TT Norms" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtReplace" Grid.Row="3" Background="#111" Foreground="#4CFF70" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderBrush="#333" Padding="10"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="🧪 Validation Matrix" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="Select a local Lua file to test your snippet against. The engine will prove if the patch works." Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <Button Content="1. Select Test File" Height="30" Background="#222" Foreground="White" FontFamily="Fonts/#TT Norms" BorderBrush="#444" Click="btnSelectTestFile_Click" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtTestFileName" Text="No file selected." Foreground="#555" FontFamily="Fonts/#TT Norms" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <Button x:Name="btnRunTest" Content="2. Run Injection Test" Height="35" Background="#C0132A" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" BorderThickness="0" Click="btnRunTest_Click" IsEnabled="False" Margin="0,0,0,15"/>

                <Border Background="#050505" BorderBrush="#333" BorderThickness="1" CornerRadius="4" Padding="10" Height="150">
                    <TextBlock x:Name="txtValidationResult" Foreground="White" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Button Content="💾 Export JSON Recipe" Height="40" Background="#1A73E8" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" BorderThickness="0" Click="btnExport_Click" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
