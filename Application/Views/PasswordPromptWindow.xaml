<Window x:Class="ToolKitV.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ToolKitV.Views"
        Title="TGToolKit — Credentials Required"
        Height="210" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D0D0D"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#0D0D0D" BorderBrush="#C0132A" BorderThickness="1" CornerRadius="10">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Drag Bar Header -->
            <Grid Grid.Row="0" MouseDown="DragBar_MouseDown" Background="Transparent" Margin="0 0 0 12">
                <DockPanel>
                    <TextBlock Text="🔑" Foreground="#C0132A" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleLabel" Text="Credentials Required" Foreground="#FFFFFF"
                               FontSize="14" FontWeight="Bold" FontFamily="Fonts/#TT Norms"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <!-- Message and Input field -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="MessageLabel"
                           Text="Please enter your SFTP password to establish remote sync:"
                           Foreground="#888888"
                           FontSize="11"
                           FontFamily="Fonts/#TT Norms"
                           TextWrapping="Wrap"
                           Margin="0 0 0 8"/>

                <Border CornerRadius="7"
                        BorderThickness="1"
                        BorderBrush="#15FFFFFF"
                        Background="#0AFFFFFF"
                        Padding="10 8"
                        Margin="0 0 0 10">
                    <PasswordBox x:Name="PromptPassword"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 FontFamily="Fonts/#TT Norms"
                                 FontSize="12"
                                 FocusVisualStyle="{x:Null}"
                                 KeyDown="PromptPassword_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Actions row -->
            <Grid Grid.Row="2" Margin="0 4 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Cancel" Width="90" Height="32" Cursor="Hand" Click="BtnCancel_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#888888" TextBlock.FontFamily="Fonts/#TT Norms" TextBlock.FontSize="11"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#2A2A2A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3" Content="Confirm" Width="100" Height="32" Cursor="Hand" Click="BtnConfirm_Click" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#C0132A" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White" TextBlock.FontFamily="Fonts/#TT Norms" TextBlock.FontSize="11" TextBlock.FontWeight="Bold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E01535"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
