<UserControl x:Class="ToolKitV.Views.SnapshotManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#050505">

    <UserControl.Resources>
        <!-- Subtle red glow for danger-zone buttons -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#60E63946" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CC2A1A"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#E63946" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="DISASTER RECOVERY" Foreground="#E63946"
                       FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
            <TextBlock Text="⏪  Snapshot Rollback" Foreground="White"
                       FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="26" Margin="0,0,0,10"/>
            <TextBlock Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="13"
                       TextWrapping="Wrap"
                       Text="TGToolKit automatically creates a full workspace snapshot before every major deployment. If something goes wrong, select a timestamp below and click Restore to instantly revert your server to that exact state."/>
        </StackPanel>

        <!-- ── Workspace path hint ── -->
        <Border Grid.Row="2" Background="#0F1117" BorderBrush="#222" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RESTORE TARGET" Foreground="#E63946" FontFamily="Fonts/#TT Norms"
                               FontWeight="Bold" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock x:Name="WorkspacePathLabel" Text="No active workspace — connect via Server Linter first."
                               Foreground="#AAA" FontFamily="Fonts/#TT Norms" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="↻  Refresh"
                        Click="RefreshButton_Click" Cursor="Hand" Height="32" Width="100"
                        Background="#1A1A2E" Foreground="#AAA" FontFamily="Fonts/#TT Norms"
                        FontSize="12" BorderThickness="1" BorderBrush="#333">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="6"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#555"/>
                                                <Setter TargetName="Bg" Property="Background" Value="#252540"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ── Snapshot list ── -->
        <Border Grid.Row="4" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- Column headers -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#111" CornerRadius="8,8,0,0" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SNAPSHOT TIMESTAMP" Foreground="#666"
                                   FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="SIZE" Foreground="#666"
                                   FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="10"/>
                        <TextBlock Grid.Column="2" Text="STATUS" Foreground="#666"
                                   FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="10"/>
                    </Grid>
                </Border>

                <ListView x:Name="SnapshotList" Grid.Row="1"
                          Background="Transparent" BorderThickness="0"
                          SelectionMode="Single"
                          SelectionChanged="SnapshotList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="20,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBg"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBg" Property="Background" Value="#0DFFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBg" Property="Background" Value="#15E63946"/>
                                                <Setter TargetName="ItemBg" Property="BorderBrush" Value="#40E63946"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FormattedDate}"
                                           Foreground="White" FontFamily="Fonts/#TT Norms" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Foreground="#AAA"
                                           FontFamily="Fonts/#TT Norms" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <Binding Path="SizeMB" StringFormat="{}{0:F2} MB"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1230E080" BorderBrush="#3030E080" BorderThickness="1"
                                            CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="✓  Safe to Restore" Foreground="#30E080"
                                                   FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyLabel" Grid.Row="1"
                           Text="No snapshots found. Run a deployment from the Global Transpiler to create one."
                           Foreground="#444" FontFamily="Fonts/#TT Norms" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ── Action row ── -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="" Foreground="#E63946"
                           FontFamily="Fonts/#TT Norms" FontSize="12"/>
            </StackPanel>

            <Button x:Name="RestoreButton" Grid.Column="1"
                    Content="⚠️  RESTORE SELECTED SNAPSHOT"
                    Height="50" Width="280" IsEnabled="False"
                    Background="#E63946" Foreground="White"
                    FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="14"
                    Cursor="Hand" Click="RestoreButton_Click"
                    Style="{StaticResource DangerButton}"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="7"
              Background="#D0050505" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="OverlayLabel" Text="RESTORING SNAPSHOT..."
                           Foreground="#E63946" FontFamily="Fonts/#TT Norms"
                           FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar IsIndeterminate="True" Width="320" Height="6"
                             Background="#222" BorderThickness="0">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF5555" Offset="0"/>
                            <GradientStop Color="#E63946" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Text="Do not close the application." Foreground="#666"
                           FontFamily="Fonts/#TT Norms" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
