<UserControl x:Class="ToolKitV.Views.Button"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d"
             d:DataContext="{Binding Mode=Default, RelativeSource={RelativeSource Self}}">
    <Grid>
        <Button Cursor="Hand"
                IsEnabled="{Binding IsButtonEnabled}"
                HorizontalAlignment="Stretch"
                Click="Button_Click"
                FocusVisualStyle="{x:Null}">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Height="42"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="#35C0132A"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Background gradient -->
                                        <Border x:Name="Bg" CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#28C0132A" Offset="0"/>
                                                    <GradientStop Color="#18C0132A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Progress bar fill (width set from code-behind) -->
                                        <Border x:Name="Progress"
                                                Width="0"
                                                HorizontalAlignment="Left">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#70C0132A" Offset="0"/>
                                                    <GradientStop Color="#50C0132A" Offset="0.7"/>
                                                    <GradientStop Color="#80FF4040" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Hover highlight overlay -->
                                        <Border x:Name="HoverOverlay"
                                                CornerRadius="8"
                                                Background="Transparent"/>

                                        <!-- Button label -->
                                        <TextBlock x:Name="Label"
                                                   Text="{Binding Title}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Fonts/#TT Norms"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#C8FFFFFF"/>
                                    </Grid>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!-- Disabled -->
                                    <DataTrigger Binding="{Binding IsButtonEnabled}" Value="False">
                                        <Setter TargetName="Bg"    Property="Opacity" Value="0.25"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="#30FFFFFF"/>
                                    </DataTrigger>

                                    <!-- Hover -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#55C0132A" Offset="0"/>
                                                    <GradientStop Color="#38C0132A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Root"         Property="BorderBrush"  Value="#70C0132A"/>
                                        <Setter TargetName="Label"        Property="Foreground"   Value="#FFFFFFFF"/>
                                        <Setter TargetName="HoverOverlay" Property="Background"   Value="#08FFFFFF"/>
                                    </Trigger>

                                    <!-- Pressed -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#70C0132A" Offset="0"/>
                                                    <GradientStop Color="#50C0132A" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#90C0132A"/>
                                        <Setter TargetName="Root" Property="Opacity"     Value="0.92"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
