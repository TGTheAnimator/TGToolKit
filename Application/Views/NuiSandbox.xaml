<UserControl x:Class="ToolKitV.Views.NuiSandbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             Background="#050505">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/> 
            <ColumnDefinition Width="420"/> 
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#333" BorderThickness="0,0,1,0">
            <cef:ChromiumWebBrowser x:Name="Browser" 
                                    Address="about:blank" 
                                    FrameLoadEnd="Browser_FrameLoadEnd"
                                    ConsoleMessage="Browser_ConsoleMessage"/>
        </Border>

        <Grid Grid.Column="1" Background="#0A0A0A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="15">
                <TextBlock Text="💻 NUI Sandbox Studio" Foreground="White" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text="Simulate FiveM client events and intercept NUI callbacks locally." Foreground="#888" FontSize="11" Margin="0,5,0,15"/>
                
                <TextBlock Text="Local HTML/UI Path:" Foreground="#AAA" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtNuiPath" Background="#111111" Foreground="White" BorderBrush="#444" BorderThickness="1" Padding="4" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Browse..." Width="80" Background="#333" Foreground="White" Margin="10,0,0,0" Click="btnLoad_Click" Cursor="Hand"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="15,0">
                <TextBlock Text="Emit Event Payload (JSON):" Foreground="#AAA" Margin="0,0,0,5"/>
                <TextBox x:Name="txtJsonPayload" Background="#111111" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" BorderBrush="#444" BorderThickness="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="250" Padding="5"/>
                
                <Button Content="Fire Event to UI" Height="35" Margin="0,15,0,0" Background="#C0132A" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnFireEvent_Click" Cursor="Hand"/>
                <Button Content="Open DevTools (F12)" Height="25" Margin="0,10,0,0" Background="#222" Foreground="#AAA" BorderThickness="1" BorderBrush="#444" Click="btnDevTools_Click" Cursor="Hand"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Intercepted Callbacks (NUI -> Lua):" Foreground="#AAA" Margin="15,10,15,5"/>
            
            <Border Grid.Row="3" Background="#111111" BorderBrush="#333" BorderThickness="0,1,0,0">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Margin="10">
                    <TextBlock x:Name="txtConsoleLog" Foreground="#00E5FF" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
