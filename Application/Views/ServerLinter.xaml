<UserControl x:Class="ToolKitV.Views.ServerLinter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="28 20 28 20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ COLUMN 0 — Controls ══ -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <Grid DockPanel.Dock="Bottom" Margin="0 16 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:Button x:Name="RunLintButton"
                              Grid.Row="0"
                              Title="Run Linter"
                              IsButtonEnabledValue="False"
                              Click="RunLintButton_Click"/>

                <!-- Fix All button — converts deprecated __resource.lua files -->
                <Button x:Name="FixAllButton"
                        Grid.Row="2"
                        Content="&#x26A1;  Fix All Manifests"
                        Click="FixAllButton_Click"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        FontWeight="Bold"
                        Height="38"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                CornerRadius="8"
                                                Background="#1A4CFF70"
                                                BorderBrush="#354CFF70"
                                                BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="#4CFF70"
                                                       FontFamily="Fonts/#TT Norms"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"  Value="#2E4CFF70"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#604CFF70"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#454CFF70"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Auto-Fix Manifests button — dedicated two-sweep manifest fixer, post-scan (local + SFTP) -->
                <Button x:Name="FixManifestsButton"
                        Grid.Row="4"
                        Content="&#x1FA84;  Auto-Fix Manifests"
                        Click="FixManifestsButton_Click"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        FontWeight="Bold"
                        Height="38"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                CornerRadius="8"
                                                Background="#1AFFD700"
                                                BorderBrush="#40FFD700"
                                                BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="#FFD700"
                                                       FontFamily="Fonts/#TT Norms"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"  Value="#30FFD700"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#65FFD700"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#48FFD700"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Auto-Wire button — fuzzy ecosystem wirer, post-scan (local + SFTP) -->
                <Button x:Name="AutoWireButton"
                        Grid.Row="6"
                        Content="&#x1F9E0;  Auto-Wire Config"
                        Click="AutoWireButton_Click"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        FontWeight="Bold"
                        Height="38"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                CornerRadius="8"
                                                Background="#20FFB347"
                                                BorderBrush="#40FFB347"
                                                BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="#FFB347"
                                                       FontFamily="Fonts/#TT Norms"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"  Value="#33FFB347"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#65FFB347"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#50FFB347"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Integration Bridge button — triggers Omni-Wirer Level 2 -->
                <Button x:Name="RunIntegrationBridgeButton"
                        Grid.Row="7"
                        Content="&#x1F30D;  Run Integration Bridge"
                        Click="RunIntegrationBridgeButton_Click"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        FontWeight="Bold"
                        Height="38"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                CornerRadius="8"
                                                Background="#20E08030"
                                                BorderBrush="#40E08030"
                                                BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="#E08030"
                                                       FontFamily="Fonts/#TT Norms"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"  Value="#33E08030"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#65E08030"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#50E08030"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Restore Backups button — subdued steel outline, non-competing with primary actions -->
                <Button x:Name="RestoreBackupsButton"
                        Grid.Row="9"
                        Content="↩  Restore Backups"
                        Click="RestoreBackupsButton_Click"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="11"
                        FontWeight="DemiBold"
                        Height="34"
                        Margin="0,4,0,0"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                CornerRadius="8"
                                                Background="#10AAAAAA"
                                                BorderBrush="#30AAAAAA"
                                                BorderThickness="1">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="#888888"
                                                       FontFamily="Fonts/#TT Norms"
                                                       FontSize="11"
                                                       FontWeight="DemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"  Value="#18AAAAAA"/>
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="#50AAAAAA"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#25AAAAAA"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0 0 8 0">
                <StackPanel>

                    <!-- Mode selector -->
                    <TextBlock Text="SCAN MODE"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 10"
                            Margin="0 0 0 16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LocalModeRadio"
                                         Content="Local Folder"
                                         IsChecked="True"
                                         Foreground="#E0FFFFFF"
                                         FontFamily="Fonts/#TT Norms"
                                         FontSize="12"
                                         Margin="0 0 20 0"
                                         Checked="ModeRadio_Changed"/>
                            <RadioButton x:Name="SftpModeRadio"
                                         Content="SFTP (Remote)"
                                         Foreground="#E0FFFFFF"
                                         FontFamily="Fonts/#TT Norms"
                                         FontSize="12"
                                         Checked="ModeRadio_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Local panel -->
                    <StackPanel x:Name="LocalPanel">
                        <TextBlock Text="RESOURCES FOLDER"
                                   Foreground="#40FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0 0 0 10"/>

                        <local:SelectFolder x:Name="LocalFolder"
                                            Title="Server Resources Folder"
                                            PropertyChanged="OnInputChanged"/>
                    </StackPanel>

                    <!-- SFTP panel (hidden by default) -->
                    <StackPanel x:Name="SftpPanel" Visibility="Collapsed">
                        <TextBlock Text="SFTP CONNECTION"
                                   Foreground="#40FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0 0 0 10"/>

                        <local:InputText x:Name="SftpHost"
                                         Title="Host / IP"
                                         PropertyChanged="OnInputChanged"
                                         Margin="0 0 0 8"/>
                        <local:InputNumber x:Name="SftpPort"
                                           Title="Port"
                                           PropertyChanged="OnInputChanged"
                                           Margin="0 0 0 8"/>
                        <local:InputText x:Name="SftpUsername"
                                         Title="Username"
                                         PropertyChanged="OnInputChanged"
                                         Margin="0 0 0 8"/>

                        <!-- Password field (native PasswordBox — never persisted) -->
                        <TextBlock Text="Password"
                                   Foreground="#40FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   Margin="0 0 0 6"/>
                        <Border CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#20FFFFFF"
                                Background="#0CFFFFFF"
                                Padding="10 8"
                                Margin="0 0 0 8">
                            <PasswordBox x:Name="SftpPassword"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontFamily="Fonts/#TT Norms"
                                         FontSize="12"
                                         PasswordChanged="OnInputChanged"/>
                        </Border>

                        <local:InputText x:Name="SftpRootPath"
                                         Title="Remote Resources Path"
                                         PropertyChanged="OnInputChanged"/>
                    </StackPanel>

                    <!-- About card -->
                    <TextBlock Text="ABOUT SERVER LINTER"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 22 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 12">
                        <StackPanel>
                            <TextBlock Text="Scans every fxmanifest.lua on your server for misconfigurations, deprecated APIs, missing declarations, and stream file conflicts."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 8"/>
                            <TextBlock Text="SFTP mode streams only text manifests — no YTD/YFT downloads required."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ══ COLUMN 2 — Results ══ -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0 0 8 0">
            <StackPanel>

                <!-- Scanning status card — visible only while the scan is running -->
                <Border x:Name="ScanningCard"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#30FF5555"
                        Background="#0DFF5555"
                        Padding="18 16"
                        Margin="0 0 0 16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ScanStatusText"
                                   Text="Initialising…"
                                   Foreground="#E0FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     BorderThickness="0"
                                     Background="#20FFFFFF">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF5555" Offset="0"/>
                                    <GradientStop Color="#C0132A" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                    </StackPanel>
                </Border>

                <!-- Summary stats -->
                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#15FFFFFF"
                        Background="#0CFFFFFF"
                        Padding="18 14"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF5555" Offset="0"/>
                                        <GradientStop Color="#C0132A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="SCAN SUMMARY"
                                       Foreground="#80FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resources Scanned" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultScanned" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resources with Issues" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultIssues" Grid.Column="1" Text="—" Foreground="#FFB347" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Warnings" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultWarnings" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Clean card -->
                <Border x:Name="CleanCard"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#1A4CFF70"
                        Background="#0A4CFF70"
                        Padding="18 14"
                        Margin="0 0 0 16"
                        Visibility="Collapsed">
                    <TextBlock Text="✓  Server is clean — no issues found."
                               Foreground="#4CFF70"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="13"
                               FontWeight="Bold"/>
                </Border>

                <!-- Issues list -->
                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#15FFFFFF"
                        Background="#0CFFFFFF"
                        Padding="18 14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF5555" Offset="0"/>
                                        <GradientStop Color="#C0132A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="ISSUES"
                                       Foreground="#80FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="IssuesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="#10FFFFFF"
                                            Background="#08FFFFFF"
                                            Padding="10 8"
                                            Margin="0 0 0 6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0"
                                                       Width="4" RadiusX="2" RadiusY="2"
                                                       Fill="{Binding SeverityColor}"
                                                       Margin="0 0 8 0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ResourceName}"
                                                           Foreground="#FFB347"
                                                           FontFamily="Fonts/#TT Norms"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="#C0FFFFFF"
                                                           FontFamily="Fonts/#TT Norms"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Button Content="🔧 Fix" Height="25" Width="50" Background="#222" Foreground="#30E080" 
                                                        FontFamily="Fonts/#TT Norms" FontSize="11" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"
                                                        Visibility="{Binding IsFixable, Converter={StaticResource BoolToVis}}"
                                                        Click="btnFix_Click" Tag="{Binding}"/>

                                                <Button Content="👁️ Ignore" Height="25" Width="60" Background="#222" Foreground="#888" 
                                                        FontFamily="Fonts/#TT Norms" FontSize="11" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"
                                                        Click="btnIgnore_Click" Tag="{Binding}"/>

                                                <Button Content="👁️ Ignore All" Height="25" Width="70" Background="#222" Foreground="#888" 
                                                        FontFamily="Fonts/#TT Norms" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        Click="btnIgnoreAll_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ INTEGRATION BRIDGE OVERLAY ══ -->
        <Grid x:Name="IntegrationOverlay" Grid.ColumnSpan="3" Background="#D0000000" Visibility="Collapsed" Panel.ZIndex="99">
            <Border Width="600" Height="400" Background="#111" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="&#x1F30D; INTEGRATION BRIDGE" Foreground="#E08030" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="The following recipes are applicable to your current workspace. Execution will permanently modify the target files." Foreground="#AAA" FontFamily="Fonts/#TT Norms" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Recipe List -->
                    <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="4" Padding="5">
                        <ItemsControl x:Name="RecipeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding RecipeId}" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#888" FontFamily="Fonts/#TT Norms" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Patches.Count, StringFormat='{}Requires {0} patches'}" Foreground="#C0132A" FontFamily="Fonts/#TT Norms" FontSize="11" VerticalAlignment="Center" FontWeight="DemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="35" Width="100" HorizontalAlignment="Left" Background="#222" Foreground="White" FontFamily="Fonts/#TT Norms" BorderThickness="0" Click="CancelIntegrationButton_Click" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="Execute Patches" Height="35" Width="150" Background="#C0132A" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" BorderThickness="0" Click="ExecuteIntegrationButton_Click" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ══ STREAM CONFLICT OVERLAY ══ -->
        <Grid x:Name="StreamConflictOverlay" Grid.ColumnSpan="3" Background="#D0000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="500" Height="300" Background="#111" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="⚠️ STREAM CONFLICT RESOLVER" Foreground="#E08030" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="16"/>
                        <TextBlock x:Name="StreamConflictDesc" Text="The following resources are streaming conflicting files." Foreground="#AAA" FontFamily="Fonts/#TT Norms" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Conflict List -->
                    <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#222" BorderThickness="1" CornerRadius="4" Padding="5">
                        <ItemsControl x:Name="StreamConflictList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Keep This Resource" Height="25" Width="120" Background="#C0132A" Foreground="White" FontFamily="Fonts/#TT Norms" FontWeight="Bold" BorderThickness="0" Click="KeepStreamResourceButton_Click" Cursor="Hand" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Button Content="Cancel" Height="35" Width="100" HorizontalAlignment="Left" Background="#222" Foreground="White" FontFamily="Fonts/#TT Norms" BorderThickness="0" Click="CancelStreamConflictButton_Click" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>



