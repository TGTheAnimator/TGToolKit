<UserControl x:Class="ToolKitV.Views.ServerLinter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d">

    <Grid Margin="28 20 28 20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ COLUMN 0 — Controls ══ -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <Grid DockPanel.Dock="Bottom" Margin="0 16 0 0">
                <local:Button x:Name="RunLintButton"
                              Title="Run Linter"
                              IsButtonEnabledValue="False"
                              Click="RunLintButton_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0 0 8 0">
                <StackPanel>

                    <!-- Mode selector -->
                    <TextBlock Text="SCAN MODE"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 10"
                            Margin="0 0 0 16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LocalModeRadio"
                                         Content="Local Folder"
                                         IsChecked="True"
                                         Foreground="#E0FFFFFF"
                                         FontFamily="Fonts/#TT Norms"
                                         FontSize="12"
                                         Margin="0 0 20 0"
                                         Checked="ModeRadio_Changed"/>
                            <RadioButton x:Name="SftpModeRadio"
                                         Content="SFTP (Remote)"
                                         Foreground="#E0FFFFFF"
                                         FontFamily="Fonts/#TT Norms"
                                         FontSize="12"
                                         Checked="ModeRadio_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Local panel -->
                    <StackPanel x:Name="LocalPanel">
                        <TextBlock Text="RESOURCES FOLDER"
                                   Foreground="#40FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0 0 0 10"/>

                        <local:SelectFolder x:Name="LocalFolder"
                                            Title="Server Resources Folder"
                                            PropertyChanged="OnInputChanged"/>
                    </StackPanel>

                    <!-- SFTP panel (hidden by default) -->
                    <StackPanel x:Name="SftpPanel" Visibility="Collapsed">
                        <TextBlock Text="SFTP CONNECTION"
                                   Foreground="#40FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0 0 0 10"/>

                        <local:InputText x:Name="SftpHost"
                                         Title="Host / IP"
                                         PropertyChanged="OnInputChanged"
                                         Margin="0 0 0 8"/>
                        <local:InputNumber x:Name="SftpPort"
                                           Title="Port"
                                           PropertyChanged="OnInputChanged"
                                           Margin="0 0 0 8"/>
                        <local:InputText x:Name="SftpUsername"
                                         Title="Username"
                                         PropertyChanged="OnInputChanged"
                                         Margin="0 0 0 8"/>

                        <!-- Password field (native PasswordBox — never persisted) -->
                        <TextBlock Text="Password"
                                   Foreground="#40FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="10"
                                   Margin="0 0 0 6"/>
                        <Border CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#20FFFFFF"
                                Background="#0CFFFFFF"
                                Padding="10 8"
                                Margin="0 0 0 8">
                            <PasswordBox x:Name="SftpPassword"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontFamily="Fonts/#TT Norms"
                                         FontSize="12"
                                         PasswordChanged="OnInputChanged"/>
                        </Border>

                        <local:InputText x:Name="SftpRootPath"
                                         Title="Remote Resources Path"
                                         PropertyChanged="OnInputChanged"/>
                    </StackPanel>

                    <!-- About card -->
                    <TextBlock Text="ABOUT SERVER LINTER"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 22 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 12">
                        <StackPanel>
                            <TextBlock Text="Scans every fxmanifest.lua on your server for misconfigurations, deprecated APIs, missing declarations, and stream file conflicts."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 8"/>
                            <TextBlock Text="SFTP mode streams only text manifests — no YTD/YFT downloads required."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ══ COLUMN 2 — Results ══ -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0 0 8 0">
            <StackPanel>
                <!-- Summary stats -->
                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#15FFFFFF"
                        Background="#0CFFFFFF"
                        Padding="18 14"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF5555" Offset="0"/>
                                        <GradientStop Color="#C0132A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="SCAN SUMMARY"
                                       Foreground="#80FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resources Scanned" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultScanned" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resources with Issues" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultIssues" Grid.Column="1" Text="—" Foreground="#FFB347" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Warnings" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultWarnings" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Clean card -->
                <Border x:Name="CleanCard"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#1A4CFF70"
                        Background="#0A4CFF70"
                        Padding="18 14"
                        Margin="0 0 0 16"
                        Visibility="Collapsed">
                    <TextBlock Text="✓  Server is clean — no issues found."
                               Foreground="#4CFF70"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="13"
                               FontWeight="Bold"/>
                </Border>

                <!-- Issues list -->
                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#15FFFFFF"
                        Background="#0CFFFFFF"
                        Padding="18 14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF5555" Offset="0"/>
                                        <GradientStop Color="#C0132A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="ISSUES"
                                       Foreground="#80FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="IssuesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="#10FFFFFF"
                                            Background="#08FFFFFF"
                                            Padding="10 8"
                                            Margin="0 0 0 6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0"
                                                       Width="4" RadiusX="2" RadiusY="2"
                                                       Fill="{Binding SeverityColor}"
                                                       Margin="0 0 8 0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ResourceName}"
                                                           Foreground="#FFB347"
                                                           FontFamily="Fonts/#TT Norms"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding Message}"
                                                           Foreground="#C0FFFFFF"
                                                           FontFamily="Fonts/#TT Norms"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
