<UserControl x:Class="ToolKitV.Views.YtdSplitter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d">

    <Grid Margin="28 20 28 20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ COLUMN 0 — Controls ══ -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <Grid DockPanel.Dock="Bottom" Margin="0 16 0 0">
                <local:Button x:Name="SplitButton"
                              Title="Split YTD Files"
                              IsButtonEnabledValue="False"
                              Click="SplitButton_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0 0 8 0">
                <StackPanel>
                    <TextBlock Text="INPUT FOLDER"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 0 0 10"/>

                    <local:SelectFolder x:Name="InputFolder"
                                        Title="Folder with .ytd files"
                                        PropertyChanged="OnPathChanged"/>

                    <TextBlock Text="OUTPUT FOLDER"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 20 0 10"/>

                    <local:SelectFolder x:Name="OutputFolder"
                                        Title="Output Destination"
                                        PropertyChanged="OnPathChanged"/>

                    <!-- Info card -->
                    <TextBlock Text="HOW IT WORKS"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0 22 0 10"/>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#15FFFFFF"
                            Background="#0CFFFFFF"
                            Padding="14 12">
                        <StackPanel>
                            <TextBlock Text="Scans your YTD files for ones exceeding 14.5 MB virtual size."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 8"/>
                            <TextBlock Text="Safe files are copied as-is. Oversized files are split using a First Fit Descending bin-packing algorithm."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 8"/>
                            <TextBlock Text="A split_txd_relationships.meta is auto-generated so GTA V can find textures across the split chunks."
                                       Foreground="#70FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ══ COLUMN 2 — Results ══ -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0 0 8 0">
            <StackPanel>
                <!-- Stats card -->
                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#15FFFFFF"
                        Background="#0CFFFFFF"
                        Padding="18 14"
                        Margin="0 0 0 16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF5555" Offset="0"/>
                                        <GradientStop Color="#C0132A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="SPLIT RESULTS"
                                       Foreground="#80FFFFFF"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Files Scanned" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultScanned" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Files Safe (Copied)" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultSafe" Grid.Column="1" Text="—" Foreground="#4CFF70" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Files Split" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultSplit" Grid.Column="1" Text="—" Foreground="#FFB347" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chunks Generated" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultChunks" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TXD Meta Generated" Foreground="#55FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12"/>
                            <TextBlock x:Name="ResultMeta" Grid.Column="1" Text="—" Foreground="#E0FFFFFF" FontFamily="Fonts/#TT Norms" FontSize="12" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Next steps card (shown after successful split) -->
                <Border x:Name="NextStepsCard"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="#1A4CFF70"
                        Background="#0A4CFF70"
                        Padding="18 14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                            <Rectangle Width="3" Height="14" RadiusX="2" RadiusY="2" Margin="0 0 8 0" Fill="#4CFF70"/>
                            <TextBlock Text="NEXT STEPS"
                                       Foreground="#4CFF70"
                                       FontFamily="Fonts/#TT Norms"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="1. Place split_txd_relationships.meta in your resource's stream/ folder."
                                   Foreground="#80FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0 0 0 6"/>
                        <TextBlock Text="2. Add to fxmanifest.lua: data_file 'GTXD_PARENTING_DATA' 'stream/split_txd_relationships.meta'"
                                   Foreground="#80FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0 0 0 6"/>
                        <TextBlock Text="3. A fxmanifest_snippet.lua has been generated in the output folder for convenience."
                                   Foreground="#80FFFFFF"
                                   FontFamily="Fonts/#TT Norms"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
