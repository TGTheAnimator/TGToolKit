<UserControl x:Class="ToolKitV.Views.SirenBuilder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ToolKitV.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Animated ToggleButton tick cell style -->
        <Style x:Key="TickStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" CornerRadius="3" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#1AFFFFFF"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C0132A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF5555"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28 20 28 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / controls row -->
        <Grid Grid.Row="0" Margin="0 0 0 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="AddRowBtn"
                        Content="+ Add Siren"
                        Click="AddRow_Click"
                        Background="#15FFFFFF"
                        Foreground="White"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        Padding="14 7"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0 0 8 0"/>
                <Button x:Name="RemoveRowBtn"
                        Content="− Remove Last"
                        Click="RemoveRow_Click"
                        Background="#15FFFFFF"
                        Foreground="White"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        Padding="14 7"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0 0 16 0"/>

                <!-- Presets -->
                <TextBlock Text="PRESET:"
                           Foreground="#40FFFFFF"
                           FontFamily="Fonts/#TT Norms"
                           FontSize="10"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0"/>
                <ComboBox x:Name="PresetCombo"
                          Background="#15FFFFFF"
                          Foreground="White"
                          BorderBrush="#20FFFFFF"
                          FontFamily="Fonts/#TT Norms"
                          FontSize="12"
                          Width="140"
                          Margin="0 0 8 0">
                    <ComboBoxItem>Alternating</ComboBoxItem>
                    <ComboBoxItem>Slow Pulse</ComboBoxItem>
                    <ComboBoxItem>Double Flash</ComboBoxItem>
                    <ComboBoxItem>Steady On</ComboBoxItem>
                    <ComboBoxItem>Rapid Burst</ComboBoxItem>
                </ComboBox>
                <Button Content="Apply to Selected"
                        Click="ApplyPreset_Click"
                        Background="#15FFFFFF"
                        Foreground="White"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        Padding="14 7"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Generate XML"
                        Click="Generate_Click"
                        Background="#C0132A"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="16 7"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0 0 8 0"/>
                <Button x:Name="CopyBtn"
                        Content="Copy"
                        Click="Copy_Click"
                        Background="#15FFFFFF"
                        Foreground="White"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        Padding="14 7"
                        FontFamily="Fonts/#TT Norms"
                        FontSize="12"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Main sequencer + output split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sequencer grid -->
            <Border Grid.Column="0"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#15FFFFFF"
                    Background="#0CFFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>

                        <!-- Beat marker header -->
                        <Grid Margin="90 0 0 4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <TextBlock Text="|" Foreground="#20FFFFFF" FontFamily="Consolas" FontSize="10" Width="80"/>
                                    <TextBlock Text="|" Foreground="#20FFFFFF" FontFamily="Consolas" FontSize="10" Width="80"/>
                                    <TextBlock Text="|" Foreground="#20FFFFFF" FontFamily="Consolas" FontSize="10" Width="80"/>
                                    <TextBlock Text="|" Foreground="#20FFFFFF" FontFamily="Consolas" FontSize="10" Width="80"/>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </Grid>                        <!-- Siren rows -->
                        <ListBox x:Name="SirenRowsList" Background="Transparent" BorderThickness="0" SelectionChanged="SirenRowsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Resources>
                                        <!-- Remove default Windows selection colors -->
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                    </Style.Resources>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row label (click to select) -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding LightName}"
                                                   Foreground="{Binding LabelForeground}"
                                                   FontFamily="Fonts/#TT Norms"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"/>

                                        <!-- Tick cells -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Ticks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource TickStyle}"
                                                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                  Click="TickCell_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Live bitmask value -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SequenceDisplay}"
                                                   Foreground="#40FFFFFF"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="8 0 0 0"/>

                                        <!-- Shift / Invert micro-buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="6 0 0 0">
                                            <Button Style="{x:Null}" Content="◄"
                                                    Tag="{Binding}"
                                                    Click="ShiftLeft_Click"
                                                    ToolTip="Shift pattern left (circular)"
                                                    Cursor="Hand"
                                                    Width="24" Height="20"
                                                    Padding="0"
                                                    FontSize="10"
                                                    Foreground="#80FFFFFF"
                                                    Background="#10FFFFFF"
                                                    BorderBrush="#15FFFFFF"
                                                    BorderThickness="1"
                                                    Margin="0 0 2 0"/>
                                            <Button Style="{x:Null}" Content="INV"
                                                    Tag="{Binding}"
                                                    Click="Invert_Click"
                                                    ToolTip="Invert pattern (flip all ticks)"
                                                    Cursor="Hand"
                                                    Width="30" Height="20"
                                                    Padding="0"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="#70C0132A"
                                                    Background="#12C0132A"
                                                    BorderBrush="#25C0132A"
                                                    BorderThickness="1"
                                                    Margin="0 0 2 0"/>
                                            <Button Style="{x:Null}" Content="►"
                                                    Tag="{Binding}"
                                                    Click="ShiftRight_Click"
                                                    ToolTip="Shift pattern right (circular)"
                                                    Cursor="Hand"
                                                    Width="24" Height="20"
                                                    Padding="0"
                                                    FontSize="10"
                                                    Foreground="#80FFFFFF"
                                                    Background="#10FFFFFF"
                                                    BorderBrush="#15FFFFFF"
                                                    BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- XML output panel -->
            <Border Grid.Column="2"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#15FFFFFF"
                    Background="#080808">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="GENERATED XML"
                               Foreground="#40FFFFFF"
                               FontFamily="Fonts/#TT Norms"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="14 12 14 8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Margin="14 0 14 14">
                        <TextBox x:Name="XmlOutput"
                                 Background="Transparent"
                                 Foreground="#4CFF70"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="10"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 Text="// Click 'Generate XML' to build your carcols.meta snippet."/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="Select a row label then apply a preset, or click individual tick cells to draw your pattern."
                   Foreground="#30FFFFFF"
                   FontFamily="Fonts/#TT Norms"
                   FontSize="11"
                   Margin="0 10 0 0"/>
    </Grid>
</UserControl>
